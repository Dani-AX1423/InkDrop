# Port on which the HTTP/WebSocket server listens
PORT=4000

# Allowed client origin(s) for CORS, comma-separated (e.g. Vercel production domain and preview URLs)
CLIENT_ORIGIN=http://localhost:3000

# Upstash Redis REST API URL for distributed multi-instance state (leave empty for in-memory mode)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io

# Upstash Redis REST API Token for distributed multi-instance state (leave empty for in-memory mode)
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
